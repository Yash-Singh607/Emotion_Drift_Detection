# URL of the FastAPI backend.
VITE_API_URL="http://127.0.0.1:8000"

# App mode:
# - production -> hides demo-only simulation and sandbox UI.
# - demo -> enables scenario simulation and developer sandbox.
VITE_APP_MODE="production"

# Request timeout for API calls in milliseconds.
VITE_API_TIMEOUT_MS="8000"

# Frontend URL used by backend OAuth callback redirect.
# Keep this synced with backend FRONTEND_APP_URL.
VITE_FRONTEND_APP_URL="http://localhost:3000"
