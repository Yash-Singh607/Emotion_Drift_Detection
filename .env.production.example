# ==============================================================================
# EMOTION DRIFT DETECTION - FREE PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Use this template to configure your production variables for completely free hosting.
# - Frontend: Hosted on Vercel Free Tier.
# - Backend: Hosted on Hugging Face Spaces (Docker SDK - CPU Basic Free).
# For local desktop execution, Electron automatically loads default values.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard)
# ------------------------------------------------------------------------------

# The absolute HTTPS endpoint where your production FastAPI backend is hosted.
# Replace with your actual Hugging Face Space URL. Format: https://<username>-<space-name>.hf.space
# If omitted or left blank in local/desktop mode, automatically falls back
# to http://127.0.0.1:8000 for local desktop app communication.
VITE_API_URL="https://username-emotion-drift.hf.space"
VITE_APP_MODE="production"
VITE_API_TIMEOUT_MS=8000


# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configure in Hugging Face Space Secrets)
# ------------------------------------------------------------------------------

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS).
# You MUST set this in production to match your hosted Vercel frontend domain!
# Example: "https://emotion-drift.vercel.app"
# If left blank, falls back to localhost origins for security.
CORS_ALLOWED_ORIGINS="https://emotion-drift.vercel.app"

# App logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL="INFO"
APP_ENV="production"

# Authentication settings
AUTH_SECRET_KEY="replace-with-a-strong-random-secret"
AUTH_ALGORITHM="HS256"
AUTH_EXPIRE_MINUTES=1440
AUTH_DB_URL="sqlite:///./auth.db"
SESSION_SECRET="replace-with-session-signing-secret"
AUTH_EXPOSE_TOKENS="false"
FRONTEND_APP_URL="https://emotion-drift.vercel.app"
FRONTEND_OAUTH_REDIRECT_PATH="/"
TRUSTED_HOSTS="emotion-drift.vercel.app,username-emotion-drift.hf.space"

# Optional OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# The dynamic port uvicorn binds to inside containers or cloud platforms.
# Hugging Face Spaces injects this variable dynamically (defaulting to 7860).
# DO NOT hardcode this value on the hosted environment.
PORT=7860

# Ensures Python output is unbuffered and sent directly to logs in real-time.
PYTHONUNBUFFERED=1

